[MASTER]
ignore=venv,data,docs,personas
jobs=0

[MESSAGES CONTROL]
# Disable noisy warnings
disable=
    C0114, # missing-module-docstring
    C0115, # missing-class-docstring
    C0116, # missing-function-docstring
    R0903, # too-few-public-methods
    W0511, # fixme
    C0103, # invalid-name
    R0801, # duplicate-code
    R0401, # cyclic-import
    W0613, # unused-argument (often needed for handler signatures)
    C0415, # import-outside-toplevel
    W0611, # unused-import (should be fixed, but suppressing for now to let tests run)
    W0718, # broad-exception-caught
    R0912, # too-many-branches
    R0913, # too-many-arguments
    R0914, # too-many-locals
    R0915, # too-many-statements

fail-under=7.0

[FORMAT]
max-line-length=88

[DESIGN]
max-args=10
max-attributes=15
