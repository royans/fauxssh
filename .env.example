# ==========================================
# SSH Honeypot Configuration (.env)
# ==========================================
# Database (Optional, for centralized logging)
# DATABASE_TYPE=postgres
# DATABASE_POSTGRES_HOST=localhost
# DATABASE_POSTGRES_PORT=5432
# DATABASE_POSTGRES_USER=honeypot
# DATABASE_POSTGRES_PASSWORD=secret
# DATABASE_POSTGRES_DBNAME=logs

# This file overrides values in config.yaml.
# Naming Convention: SECTION_KEY (e.g. llm.model_name -> LLM_MODEL_NAME)

# --- LLM Settings ---
# Required for dynamic personas and content generation.
# GOOGLE_API_KEY is legacy support for LLM_API_KEY.
LLM_API_KEY=your_google_api_key_here
# LLM_MODEL_NAME="gemma-3-27b-it"
LLM_max_tokens=2048
LLM_temperature=1.0

# --- Server ---
#SERVER_PORT=2222
# SERVER_HOSTNAME="web.blogofy.com"

# --- HTTP Service ---
# HTTP_ENABLED=true
#HTTP_PORT=8080
# HTTP_LLM_RPM=4
# HTTP_LLM_RPD=20
# HTTP_SERVER_HEADER="Apache/2.4.52 (Ubuntu)"

# --- SSH Service / Telnet ---
# TELNET_ENABLED=true
#TELNET_PORT=2323

# --- Redis Service ---
# REDIS_ENABLED=true
#REDIS_PORT=6379

# --- MCP Service (Model Context Protocol) ---
# MCP_ENABLED=true
#MCP_PORT=8000
# MCP_MAX_LLM_CALLS=20
# MCP_THROTTLE_DELAY=2.0

# --- Analytics & Reporting ---
# Comma-separated list of IPs to hide from "Top IPs" and analysis
ANALYTICS_IGNORE_IPS=127.0.0.1,::1

# --- Alerting (Webhooks) ---
# Supports Discord, Slack, etc.
# ALERTING_WEBHOOK_URL=""
ALERTING_NOTIFY_THRESHOLD=6  # Risk score (0-10) to fire webhook

# --- VirusTotal Integration ---
# Used for automatic file analysis
# VIRUSTOTAL_ENABLED=false
# VIRUSTOTAL_API_KEY=""

# --- Throttling (Rate Limits) ---
# Protects against DoS and Budget Exhaustion
# Dos Protection (Global)
THROTTLING_DOS_RPM=120
THROTTLING_DOS_RPH=3600
THROTTLING_DOS_RPD=20000

# LLM Throttle (Expensive)
THROTTLING_LLM_RPM=5
THROTTLING_LLM_RPH=60
THROTTLING_LLM_RPD=200

# --- Persona ---
# Override the active persona (folder name in ./personas/)
# SSH_PERSONA="Debian12_GPU_8GB"

# --- Logging & Centralized Events ---
# Set to 'true' to disable batch processing in slogging (for debugging lag).
# Default: false (batching enabled)
# LOGGING_DISABLE_BATCHING=false

# Centralized Logging (ZeroMQ)
# Mode: [local, zmq, both]. Default is 'local' (direct write to slogger).
# CLOGGING_MODE=local

# ZeroMQ Shared Configuration (Client & Server)
# URL: Target IP/Host for client, Port extracted for server bind.
# LOGGING_ZMQ_URL="tcp://127.0.0.1:5555"
# LOGGING_ZMQ_USER=admin
LOGGING_ZMQ_PASS=secret_password_here
