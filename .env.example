GOOGLE_API_KEY=your_api_key

# Optional: Custom Data Directory (absolute or# Feature Flags
# FAUXSSH_DATA_DIR=./data  # Custom data directory override

# Persona Override
# Specify the name of a folder in ./personas/ (e.g. Debian12_GPU_8GB)
# OR an absolute path to a persona directory.
# SSHPOT_PORT=2222
SSHPOT_ENABLE_TELNET=true
SSHPOT_TELNET_PORT=2323
SSHPOT_ENABLE_REDIS=true
SSHPOT_REDIS_PORT=6379
SSHPOT_ENABLE_MCP=true
SSHPOT_MCP_PORT=8000
# HTTP LLM Rate Limiting
# HTTP_LLM_RPM=4   # Requests per minute
# HTTP_LLM_RPD=20  # Requests per day
# MCP Quotas & Throttling
SSHPOT_MCP_MAX_LLM_CALLS=20
SSHPOT_MCP_THROTTLE_DELAY=2.0
# SSH_PERSONA=CentOS7_Legacy_Compute
# ANALYTICS_IGNORE_IPS=127.0.0.1,192.168.1.50


# --- Optional: Real-time Discord/Slack Notifications ---
# These settings are NOT required and not needed unless you specifically want to setup discord notification.
# WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE"
# ALERT_THRESHOLD_NOTIFY=6   # Risk score (0-10) to send notification
# ALERT_THRESHOLD_SESSION=7  # Risk score to trigger session analysis
# ALERT_THRESHOLD_IP=9       # Risk score to trigger IP intelligence
# ALERT_KEYWORDS="hackblogofy|bashcrack" # Pipe-separated list of keywords to force alert
